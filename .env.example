# ---- SHARED ENVS ------------------------------------------------

NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_URL=

ZARINPAL_MERCHANT_ID=
ZARINPAL_AMOUNT=10000
ZARINPAL_SUBSCRIPTION_DAYS=30
ZARINPAL_PAYMENT_PORTAL_URL=https://www.zarinpal.com/pg/services/payment

# ---- PRODUCTION / SELF-HOSTED (دامنه جدید خود را جایگزین کنید) ---
# برای استفاده بدون Supabase، این مقادیر را خالی بگذارید و از حالت احراز هویت داخلی استفاده کنید.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL="postgres://postgres:<YOUR_PROJECT_PASSWORD>@db.<YOUR_PROJECT_ID>.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<YOUR_PROJECT_PASSWORD>@db.<YOUR_PROJECT_ID>.supabase.co:5432/postgres"

# در مقادیر زیر دامنه اصلی خود را جایگزین کنید
ZARINPAL_CALLBACK_URL=https://your-domain.com/payments-api/zarinpal-callback
ZARINPAL_SUCCESS_REDIRECT=https://your-domain.com/dashboard
ZARINPAL_FAILURE_REDIRECT=https://your-domain.com/billing?status=failed
ZARINPAL_SANDBOX=false

